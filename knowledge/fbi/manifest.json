  "dossier_schema": {
    "tim_witness": {
      "purpose": "Preserve Tim/project witness about character, fruit, karma, Potato-of-Life placement, symbols, witnessed effects and possible transformation without presenting that witness as independent clinical/legal fact.",
      "fields": [
        "character_reading",
        "fruit",
        "karma",
        "placement",
        "roles",
        "witnessed_effects",
        "symbols",
        "debt_relation",
        "inherited_states",
        "episode_attributes",
        "state_modifiers",
        "repair_path",
        "sayings",
        "boundary"
      ],
      "attribution_rule": "All Tim-witness judgments remain explicitly attributed to Tim/project interpretation and may vary by date/scene."
    },
    "state_history": {
      "purpose": "Explain how Tim/project classification changes over time by interleaving roles, inherited symbolic states, debt-associated episodes, repair credit and upgrades/handicaps.",
      "rule": "State history is descriptive and source-bounded; it is not a score, diagnosis, or claim that later states erase earlier ones."
