{
  "id": "cia-characters-incidents-associations",
  "title": "CIA — Characters, Incidents & Associations",
  "subtitle": "Potatoverse Character Knowledge & Conversation Archive",
  "version": "1.3.0",
  "updated": "2026-09-20",
  "disclaimer": "CIA here means Characters, Incidents & Associations. This is a Potatoverse research/archive acronym. It is not the U.S. Central Intelligence Agency, is not affiliated with any intelligence or law-enforcement service, and does not make official investigative findings.",
  "purpose": "A provenance-aware character knowledge system for recurring people, handles and created figures: chronology, conversations, associations, incidents, Story appearances, role changes, ordinary-life texture, evidence/source classes, unresolved questions and research leads.",
  "bureau_logic": {
    "characters": "Who appears, under what names, in which periods and source strata, and how does the figure change over time?",
    "incidents": "What dated or bounded scene materially changes what the archive knows about a person, role, relationship, boundary or project artifact?",
    "associations": "Who appears with whom, in what contexts, with what interaction modes, and how does that relation change?",
    "conversations": "What was said or recovered from chat, with what source class, ordinary-life detail and uncertainty?",
    "patterns": "What recurring modes, role shifts, tensions, counter-patterns and ordinary-life signals emerge without freezing a person into one archetype?",
    "knowledge": "What topics, places/contexts, source types, story appearances, role families and open questions can be assembled across the archive?",
    "tim_centering_rule": "Each dossier may record relation to Tim because Tim is the project's central subject, but no person is reduced to loyalty, opposition, usefulness or proximity to Tim.",
    "source_rule": "Public chat, conversation recovery, Chronicle prose, literary Great Book, user-supplied descriptive context, public records and later project synthesis remain distinct source strata.",
    "enhancement_rule": "Ordinary/documentary capabilities and creative/project-only traits remain separate so fictional powers or symbolic roles are never silently treated as biography.",
    "tim_witness": "What did Tim say he witnessed this figure producing: growth, harm, noise, repair, debt, symbolic role, placement and transformation?",
    "debt": "Track individual debt only when explicitly assigned; otherwise record relation to debt-producing or repair-producing episodes without inventing amounts."
  },
