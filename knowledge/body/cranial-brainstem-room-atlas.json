  "title": "Cranial & Brainstem Rooms — Nerves, Functional Columns, Arousal and Vital-State Circuits",
  "status": "specialist cranial/brainstem neurobiology owner",
  "purpose": "Expose the brainstem as a structured continuation of the spinal axis: cranial nerve nuclei, sensory/motor/autonomic columns, visceral return, respiratory control, arousal and sleep/wake circuitry.",
  "organizing_principle": "Embryologically, brainstem nuclei retain a transformed dorsal-sensory / ventral-motor organization around the opened fourth ventricle. Functional columns help explain why cranial sensory, branchial motor, somatic motor and parasympathetic nuclei occupy recurring longitudinal territories.",
  "cranial_nerves": [
    {
      "nerve": "I",
      "name": "Olfactory",
      "brainstem_nuclei": "No primary brainstem nucleus; olfactory bulb/tract and forebrain circuits",
      "roles": [
        "smell"
      ],
      "project": "nostril/smell exception",
      "boundary": "Classic exception to simplified 'all senses first relay through thalamus' rule."
    },
    {
      "nerve": "II",
      "name": "Optic",
      "brainstem_nuclei": "Retina is CNS; major targets include LGN, superior colliculus, pretectum, SCN",
      "roles": [
        "vision",
        "pupillary reflex input",
        "circadian light input"
      ],
      "project": "World-Eye / Clock-Eye bifurcation"
    },
    {
      "nerve": "III",
      "name": "Oculomotor",
      "brainstem_nuclei": "Oculomotor + Edinger-Westphal complex, midbrain",
      "roles": [
        "most extraocular movement",
        "pupil constriction",
        "lens accommodation"
      ],
      "project": "gaze/action + autonomic Eye"
    },
    {
      "nerve": "IV",
      "name": "Trochlear",
      "brainstem_nuclei": "Trochlear nucleus, midbrain",
      "roles": [
        "superior oblique eye movement"
      ],
      "project": "crossed eye-motor road",
      "boundary": "Only cranial nerve exiting dorsally; fibers decussate."
    },
    {
      "nerve": "V",
      "name": "Trigeminal",
      "brainstem_nuclei": "Mesencephalic, principal sensory, spinal trigeminal + motor nucleus",
      "roles": [
        "face sensation",
        "corneal sensation",
        "mastication",
        "proprioception"
      ],
      "project": "face/body-report complex"
    },
    {
      "nerve": "VI",
      "name": "Abducens",
      "brainstem_nuclei": "Abducens nucleus, pons",
      "roles": [
        "lateral rectus",
        "horizontal gaze circuitry"
      ],
      "project": "gaze coordination"
    },
    {
      "nerve": "VII",
      "name": "Facial",
      "brainstem_nuclei": "Facial motor nucleus; superior salivatory/lacrimal parasympathetic; solitary taste inputs",
      "roles": [
        "facial expression",
        "taste anterior tongue",
        "lacrimation/salivation"
      ],
      "project": "expression + taste + glandular output"
    },
    {
      "nerve": "VIII",
      "name": "Vestibulocochlear",
      "brainstem_nuclei": "Vestibular and cochlear nuclei",
      "roles": [
        "hearing",
        "balance",
        "head-motion/gravity sensing"
      ],
      "project": "orientation + hearing"
    },
    {
      "nerve": "IX",
      "name": "Glossopharyngeal",
      "brainstem_nuclei": "Nucleus ambiguus; inferior salivatory; NTS; spinal trigeminal",
      "roles": [
        "taste posterior tongue",
        "carotid chemo/barosensation",
        "pharyngeal motor",
        "parotid parasympathetic"
      ],
      "project": "blood-state / throat report"
    },
    {
      "nerve": "X",
      "name": "Vagus",
      "brainstem_nuclei": "NTS; dorsal motor nucleus; nucleus ambiguus; spinal trigeminal",
      "roles": [
        "visceral afference",
        "parasympathetic organ control",
        "laryngeal/pharyngeal motor",
        "taste epiglottic region"
      ],
      "project": "wandering Return / visceral descent"
    },
    {
      "nerve": "XI",
      "name": "Accessory",
      "brainstem_nuclei": "Spinal accessory nucleus; cranial contribution historically grouped with vagus",
      "roles": [
        "sternocleidomastoid/trapezius motor"
      ],
      "project": "head/shoulder orientation action"
    },
    {
      "nerve": "XII",
      "name": "Hypoglossal",
      "brainstem_nuclei": "Hypoglossal nucleus, medulla",
      "roles": [
        "tongue motor control"
      ],
      "project": "Word / articulation final motor road"
    }
  ],
