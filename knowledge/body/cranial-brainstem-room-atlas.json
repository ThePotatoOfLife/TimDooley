  "vital_loops": [
    {
      "name": "Baroreflex",
      "route": "carotid/aortic stretch → IX/X → NTS → medullary autonomic networks → sympathetic/parasympathetic output",
      "project": "pressure report → rapid correction"
    },
    {
      "name": "Chemoreflex",
      "route": "carotid/aortic bodies + central CO2/pH-sensitive networks → brainstem respiratory/autonomic circuits",
