{
  "id": "entity-facet-ledger",
  "version": "1.2.0",
  "updated": "2026-09-27",
  "purpose": "Retain names, aliases, titles, gifts, capabilities, scene-bound powers, recurring roles, story beats, conclusions and unresolved edges for Potatoverse/project entities without forcing every public page to repeat the full record.",
  "principles": [
    "A facet is attached to an entity, but it is also typed by provenance, scope and confidence.",
    "A one-scene power is not promoted to a species trait until it recurs or a source explicitly generalizes it.",
    "Titles and epithets may be literary, social, self-declared, bestowed, comic or documentary; the type must stay attached to the label.",
    "Real-person ordinary capabilities remain separate from creative/project enhancements.",
    "A conclusion records what the archive currently thinks the evidence supports; it may change without erasing the earlier story beat.",
    "Unresolved questions remain first-class facets instead of being silently answered."
  ],
  "facet_types": {
    "alias": "Alternate name, handle or spelling.",
    "title": "Title, epithet, rank or honorific.",
    "capability": "Ordinary or project-specific ability/capacity.",
    "signature_trait": "Distinctive recurring trait strongly associated with the entity.",
    "species_trait": "Trait generalized to a collective/species.",
    "scene_power": "Power or property established only in one story/scene unless later repeated.",
    "role": "Recurring project, literary or social function.",
    "relation": "Stable relation to another being, place, system or concept.",
    "motif": "Recurring symbolic object, number, phrase or pattern.",
    "story_beat": "Dated or period-specific event that changes what the entity means.",
    "conclusion": "Current archive synthesis derived from several facets.",
    "boundary": "What must not be inferred or merged.",
    "open_question": "Unresolved recovery or interpretation question."
  },
  "strength_levels": {
    "canonical": "Repeated or explicitly established project canon.",
    "repeated": "Recovered independently in multiple scenes/sources.",
    "established_scene": "Clearly present in one bounded scene.",
    "interpretive": "Archive synthesis that fits evidence but is not itself a quoted/source-native label.",
    "hypothesis": "Useful possibility awaiting stronger recovery.",
    "unresolved": "Known gap or ambiguity."
  },
