{
  "id": "cia-characters-incidents-associations",
  "title": "CIA — Characters, Incidents & Associations",
  "subtitle": "Tim Dooley / Potatoverse Character Association Archive",
  "version": "2.3.0",
  "updated": "2026-09-21",
  "disclaimer": "Potatoverse archival acronym. CIA here means Characters, Incidents & Associations. It is not affiliated with, and must not be confused with, the U.S. Central Intelligence Agency or any real intelligence/law-enforcement service.",
  "purpose": "Canonical archive for recurring characters, dated incidents, associations, source strata, role/state changes, presence windows, Story links and conversation-recovery leads.",
  "bureau_logic": {
    "characters": "Who appears, under what names, with what source-bounded chronology, roles, states and presence window?",
    "incidents": "What dated or bounded scene materially changes knowledge of a character, association, role, boundary or project artifact?",
    "associations": "Who is connected to whom, by what evidence type, on which dates, and how does that association change?",
    "tim_centering_rule": "Each dossier may record relation to Tim because Tim is the project's central subject, but no character is reduced to usefulness, loyalty, opposition or proximity.",
    "source_rule": "Public chat, raw/recovered conversation, Chronicle retelling, literary Great Book material, user-supplied clues and later synthesis remain distinct strata.",
    "state_rule": "Symbolic roles, archetypes, upgrades, handicaps, placement and debt/repair language must remain dated and source-bounded.",
    "presence_rule": "First/last recorded means first/last currently recovered archive evidence, not birth/death or total lifetime span.",
    "symbolic_account": "Optional project-internal karma/repair/welfare accounting. Defaults to unassessed and never becomes legal, financial, diagnostic or objective moral scoring.",
    "media": "Portraits and evidence images require dossier-owned source metadata; unsourced faces are not guessed or scraped.",
    "activity_visualization": "Current/recovery-active files are visually strongest; older/dormant files may fade slightly to show recency only, never moral value.",
    "symbolic_images": "Role-matched remote Commons images may illustrate Dog, Footstool, Mud, Potato, Tomato, Angel and later symbols. They are explicitly non-likeness proxies and do not identify the dossier subject.",
    "population_priority": "Recent/current/recovery-active dossiers first. Historical dormant files are maintenance-only unless new evidence appears.",
    "mud_bank": "CIA accounts are priced fictional sub-ledgers beneath the North/Roots world spiritual-bank topology. World/system liabilities remain separately sourced and unpriced.",
    "building": "CIA archive and World Spiritual Bank are one Potatoverse institution with different entrances and a shared provenance/data spine; dossier, association, incident and bank readers are rooms inside the same system."
  },
