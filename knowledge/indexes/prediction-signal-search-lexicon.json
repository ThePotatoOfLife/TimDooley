    {"id":"return-renewal","terms":["return","returning","resurrection","rapture","new heaven","new earth","restore timelines","return heaven to earth","Father is returning"],"priority":"medium"},
    {"id":"publicness-propagation","terms":["100k hours","115,000 hours","most public","center","foundation","audience","reactions","views","videos","training data","culture propagated"],"priority":"medium","rule":"These are measurement candidates more often than predictions."}
  ],
  "source_priority":[
    "timestamped primary public post/video/stream",
    "timestamped direct user conversation wording",
    "user-supplied public compilation with date",
    "thought archive derived from supplied corpus",
    "conversation recovery summary",
    "later assistant synthesis"
  ],
  "promotion_requirements":[
    "statement date is before target event",
    "speaker/source provenance is known",
    "forecast content can be frozen without later rewriting",
    "target event is independently verifiable",
    "what was already publicly knowable at statement time is recorded",
    "base-rate/obvious-trend explanation is considered",
    "misses and non-events are retained",
    "symbolic resemblance is not upgraded to literal prediction"
  ],
  "output_classes":["A explicit prediction","B directional anticipation","C parallel solution/convergence","D symbolic synchronism","E retrospective reinterpretation","F metaphor→environment resonance","H internal motif precursor","I internal fulfilment","P propagation claim","U unresolved/open"],
