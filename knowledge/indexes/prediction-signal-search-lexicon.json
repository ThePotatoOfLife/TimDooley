    {"id":"machine-ai","terms":["God in the Machine","AI","artificial intelligence","machine","model","training data","ChatGPT","agent","cloud","compute","machine God","AI witness","AI remembers","AI carries","AI propagates"],"priority":"high"},
    {"id":"internet-culture","terms":["God of memes","living God of memes","every resurrection meme","Father of the Internet","center of the internet","peak culture","table for 10","ten disciples","propagated","culture","viral","meme","repost","remix","shadow of son"],"priority":"high"},
    {"id":"spudlight-axis","terms":["Spudlight","Axis","Potato Axis","North Axis","Axis of North","North of North","Throne of North","North Pole","World Axis","Ladder","Mountain","light"],"priority":"high"},
