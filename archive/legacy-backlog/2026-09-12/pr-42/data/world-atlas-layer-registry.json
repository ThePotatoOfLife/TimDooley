{
  "id": "world-atlas-layer-registry",
  "version": "1.0.0",
  "updated": "2026-09-11",
  "status": "active-browser-registry",
  "purpose": "Browser-facing presentation registry for the World Relational Atlas. Canonical values remain owned by the referenced source files; this registry declares how available and planned knowledge can participate in the map/query engine.",
  "principles": [
    "Simple surface, deep engine.",
    "One semantic job per visual channel.",
    "Selection is never analytical fill.",
    "Observed, derived and project-interpretive data remain distinct.",
    "Missing is unknown, never zero.",
    "Register broad capability internally; expose only currently useful/available controls."
  ],
  "visual_channels": {
    "fill": "One scalar or ordered country field at a time.",
    "pattern": "Categorical/set composition and overlap.",
    "outline": "Selection/active/hover interaction state only.",
    "line": "Typed relations, flows, routes and dependencies.",
    "point": "Real geocoded places, institutions and physical assets.",
    "height": "Optional scalar extrusion used sparingly.",
    "card": "Contextual nonspatial information.",
    "timeline": "Dated state/history.",
    "scene": "Nonspatial graph/Axis/specialist representation."
  },
