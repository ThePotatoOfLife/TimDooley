  "known_duplicate_patterns":[
    {"pattern":"country enrichment batch files vs data/countries/*-enrichment.json","resolution":"batch overlays are inputs; per-country enrichment records are normalized outputs when present"},
    {"pattern":"religious-layer-map vs religious-layer-manifest","resolution":"manifest owns navigation/file inventory; layer-map owns coupling/taxonomy rules"},
    {"pattern":"belief-registry vs religious-lexicon","resolution":"registry owns routing; lexicon owns definitions"},
    {"pattern":"graph-registry vs nodes.json","resolution":"graph-registry owns lightweight addressability; nodes owns substantive canonical records"},
    {"pattern":"expansion files vs nodes.json","resolution":"expansions are research candidates until promotion criteria are met"},
    {"pattern":"Potatoism mythology vs empirical research","resolution":"symbolic records remain project-canon; evidence records remain independently sourced"}
  ],
  "orphan_policy":"A file is not orphaned merely because it lacks a direct HTML page. Research-only, schema, source and validation files are valid backend owners if they have a declared consumer and graph role.",
  "retirement_policy":"No deletion by filename similarity. First assign canonical owner, migrate consumers, mark compatibility-only, then remove after validation."
