  "pattern_bridges": [
    {
      "id_pattern": "country:<canonical-country-id>",
      "source": "data/countries/index.json",
      "owners": [
        "data/countries/<id>.json",
        "data/country-nodes.json"
      ],
      "route": "world-map/",
      "graph_relation": "located-in / trades-with / depends-on / member-of / governed-by"
    },
    {
      "id_pattern": "belief:<slug>",
      "source": "data/belief-registry.json",
      "owners": [
        "data/religious-lexicon.json",
        "data/political-lexicon.json",
        "data/potatoism-religion.json"
      ],
      "route": "explore/",
      "graph_relation": "influences / branches-from / practiced-in / interpreted-by"
    },
    {
      "id_pattern": "religion:<id>",
      "source": "data/religious-layer-map.json",
      "owners": [
        "data/religious-foundations/records.json",
        "data/religious-adjacent/records.json",
        "data/canonical-texts.json"
      ],
      "route": "religion/",
      "graph_relation": "emerges-from / branches-into / text-preserves / practiced-in / located-at / influenced-by"
    },
    {
      "id_pattern": "research:<wave-id>",
      "source": "data/expansion-registry.json",
      "owners": [
        "data/expansions/*.json"
      ],
      "route": "explore/",
      "graph_relation": "researches / expands / proposes / supports / contradicts"
    },
    {
      "id_pattern": "source:<id>",
      "source": "data/religious-sources.json + data/country-source-registry.json + data/sources/**/*.json",
      "owners": [
        "source registries",
        "source documents"
      ],
      "route": "context/source-authority/",
      "graph_relation": "supports / contradicts / updates / cites"
    },
    {
      "id_pattern": "foundation:<id>",
      "source": "data/house/foundation-integration-contract.json",
      "owners": [
        "cross-domain foundation records",
        "domain canonical subject owner"
      ],
      "route": "house/#foundations",
      "graph_relation": "founded-by / constituted-by / authorized-by / reproduces-through / refounded-by / branches-from / supersedes",
      "source_records": [
        "data/house/foundations-wave-001.json",
        "data/house/foundations-wave-002.json",
        "data/house/foundations-wave-003.json"
      ]
    }
  ],
  "orphan_classes": [
