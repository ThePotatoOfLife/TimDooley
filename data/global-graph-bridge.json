{
  "version":"1.1.0",
  "updated":"2026-09-07",
  "purpose":"Bridge registry connecting backend-layer IDs to the global graph without forcing every schema or source record into data/nodes.json. Canonical records can be promoted; references remain resolvable through source-layer routing.",
  "global_graph":"data/relationships.json",
  "canonical_node_registry":"data/nodes.json",
  "reference_registry":"data/graph-registry.json",
  "bridge_rules":[
    "A substantive entity gets one canonical ID and one primary owner.",
    "A research-layer ID may remain outside nodes.json while its source file and route are explicit.",
    "Relationship endpoints may point to reference-only IDs, but those IDs must resolve through this bridge or the graph registry.",
    "Country IDs resolve through data/countries/index.json and country-node manifests.",
    "Blueprint IDs are schema identifiers, not graph entities unless a concrete record exists.",
    "Source documents are graph-addressable source nodes but are not automatically substantive entities.",
    "Project-symbolic records must retain an epistemic class that prevents them from being mistaken for empirical observations."
  ],
  "explicit_bridges":[
    {"id":"tim-dooley","owner":"data/tim-dooley-cosmology.json","graph_registry":"data/graph-registry.json","route":"node.html?id=tim-dooley","class":"project-mythic"},
    {"id":"potatoism","owner":"data/potatoism-religion.json + data/potatoism-master-corpus.json","graph_registry":"data/graph-registry.json","route":"potatoism.html","class":"project-defined-symbolic"},
    {"id":"potatoism-entities","owner":"data/potatoism-entities.json","route":"potatoism.html","class":"project-symbolic-registry"},
