    {"id":"north-programme","owner":"data/nodes.json + data/expansions/global-field-deep-carving-wave-021.json","route":"node.html?id=north-programme","class":"policy-research-framework"},
    {"id":"european-union","owner":"data/nodes.json + data/evidence-map.json","route":"node.html?id=european-union","class":"empirical-institution"},
    {"id":"denmark","owner":"data/countries/denmark.json + data/country-nodes*.json","route":"nation.html?id=denmark","class":"empirical-country"},
    {"id":"greenland","owner":"data/nodes.json + country/territory layer","route":"node.html?id=greenland","class":"empirical-territory"},
    {"id":"religious-layer","owner":"data/religious-layer-map.json","route":"belief.html","class":"navigation-layer"},
    {"id":"people-layer","owner":"data/people-seed-records.json + data/people-registry.json","route":"people.html","class":"people-layer"},
    {"id":"evidence-layer","owner":"data/evidence-map.json + data/evidence/observations.json","route":"repository.html#evidence","class":"evidence-layer"}
  ],
  "pattern_bridges":[
    {"id_pattern":"country:<canonical-country-id>","source":"data/countries/index.json","owners":["data/countries/<id>.json","data/countries/<id>-enrichment.json","data/country-nodes*.json"],"route":"nation.html?id=<id>","graph_relation":"located-in / trades-with / depends-on / member-of / governed-by"},
    {"id_pattern":"belief:<slug>","source":"data/belief-registry.json","owners":["data/religious-lexicon.json","data/political-lexicon.json","data/potatoism-religion.json"],"route":"belief.html?id=<slug>","graph_relation":"influences / branches-from / practiced-in / interpreted-by"},
    {"id_pattern":"religion:<id>","source":"data/religious-layer-map.json","owners":["data/religious-foundations*.json","data/religious-adjacent/**/*.json","data/canonical-texts.json"],"route":"node.html?id=<id>","graph_relation":"emerges-from / branches-into / text-preserves / practiced-in / located-at / influenced-by"},
    {"id_pattern":"potatoism:<id>","source":"data/potatoism-entities.json","owners":["data/potatoism-deep-layers.json","data/potatoism-glossary.json","data/potatoism-event-and-relation-atlas.json","data/potatoism-public-observations.json"],"route":"node.html?id=<id>","graph_relation":"embodies / manifests-as / connects / complements / extends / transforms"},
    {"id_pattern":"research:<wave-id>","source":"data/expansion-registry.json","owners":["data/expansions/*.json"],"route":"repository.html#research","graph_relation":"researches / expands / proposes / supports / contradicts"},
    {"id_pattern":"source:<id>","source":"data/religious-sources.json + data/country-source-registry.json + data/sources/**/*.json","owners":["source registries","source documents"],"route":"node.html?id=<id>","graph_relation":"supports / contradicts / updates / cites"}
  ],
  "orphan_classes":["unreferenced-id","relationship-endpoint-without-owner","owner-without-consumer","duplicate-canonical-id","same-content-different-id","source-without-provenance","research-layer-without-promotion-status"],
  "next_action":"scripts/audit_backend_coverage.py must scan these classes on every CI run and fail only for critical unresolved identity or structural collisions; research-only gaps remain reportable without blocking release."
