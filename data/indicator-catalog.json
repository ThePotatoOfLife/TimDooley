{
  "version":"1.0.0",
  "updated":"2026-09-07",
  "purpose":"Canonical indicator catalogue for expanding country and system records without inventing values. It defines what should be measured, how it connects to the atlas, and which source families should be preferred.",
  "principle":"A field is not populated merely because a file exists. Each observation needs a value, unit, reference period, publication date, source and confidence. Missing is a valid state.",
  "dimensions":[
    {"id":"population","label":"Population","unit":"persons","priority":"critical","source_families":["UN Population Division","World Bank","national statistical office"],"links":["labour-demography","migration","healthcare-care","education-skills","housing-real-estate"]},
    {"id":"population-growth","label":"Population growth","unit":"percent/year","priority":"high","source_families":["World Bank","UN Population Division","national statistical office"],"links":["population","labour-demography","housing-real-estate","public-finance"]},
    {"id":"median-age","label":"Median age","unit":"years","priority":"high","source_families":["UN Population Division","national statistical office"],"links":["population","healthcare-care","labour-demography","pensions"]},
    {"id":"fertility","label":"Total fertility rate","unit":"births per woman","priority":"high","source_families":["UN Population Division","national statistical office"],"links":["population","education-skills","healthcare-care","labour-demography"]},
    {"id":"life-expectancy","label":"Life expectancy","unit":"years","priority":"high","source_families":["World Bank","WHO","national statistical office"],"links":["population","healthcare-care","labour-demography"]},
    {"id":"gdp","label":"GDP","unit":"national currency / USD / EUR","priority":"critical","source_families":["World Bank","IMF","Eurostat","national accounts"],"links":["public-finance","trade","labour","finance"]},
    {"id":"gdp-per-capita","label":"GDP per capita","unit":"currency/person","priority":"critical","source_families":["World Bank","IMF","Eurostat"],"links":["population","gdp","living-conditions"]},
    {"id":"real-growth","label":"Real GDP growth","unit":"percent/year","priority":"high","source_families":["Eurostat","IMF","World Bank","national accounts"],"links":["gdp","investment","labour","trade"]},
    {"id":"inflation","label":"Consumer-price inflation","unit":"percent/year","priority":"high","source_families":["Eurostat","IMF","national statistics"],"links":["households","wages","central-bank","finance"]},
    {"id":"unemployment","label":"Unemployment rate","unit":"percent of labour force","priority":"critical","source_families":["ILO","Eurostat","national labour statistics"],"links":["labour-demography","education-skills","public-finance"]},
    {"id":"productivity","label":"Labour productivity","unit":"GDP per hour / worker","priority":"high","source_families":["OECD","Eurostat","national accounts"],"links":["labour","technology","investment","education"]},
    {"id":"public-debt","label":"General government gross debt","unit":"currency","priority":"critical","source_families":["Eurostat","IMF","World Bank","national treasury"],"links":["public-finance","interest-cost","population","gdp"]},
    {"id":"debt-to-gdp","label":"Government debt to GDP","unit":"percent","priority":"critical","source_families":["Eurostat","IMF","national treasury"],"links":["public-debt","gdp","interest-cost","fiscal-balance"]},
