    {"id":"government-revenue","label":"Government revenue","unit":"currency / percent GDP","priority":"high","source_families":["Eurostat","IMF","national treasury"],"links":["taxation","public-services","debt"]},
    {"id":"government-expenditure","label":"Government expenditure","unit":"currency / percent GDP","priority":"high","source_families":["Eurostat","IMF","national treasury"],"links":["healthcare","education","defence","pensions","infrastructure"]},
    {"id":"public-investment","label":"Public investment","unit":"currency / percent GDP","priority":"high","source_families":["Eurostat","IMF","national accounts"],"links":["infrastructure","construction","research","energy"]},
    {"id":"trade","label":"Goods and services trade","unit":"currency","priority":"critical","source_families":["Eurostat","UN Comtrade","national customs"],"links":["ports","logistics","manufacturing","energy"]},
    {"id":"trade-concentration","label":"Trade partner concentration","unit":"index / share","priority":"high","source_families":["Eurostat","UN Comtrade"],"links":["trade","strategic-dependencies","supply-chains"]},
    {"id":"energy-dependence","label":"Net energy import dependence","unit":"percent","priority":"critical","source_families":["Eurostat","IEA","national energy agencies"],"links":["energy-generation","oil-gas-fuels","energy-networks","geopolitics"]},
