    {"id":"migration","label":"Migration flows and stocks","unit":"persons","priority":"critical","source_families":["UN DESA","OECD","Eurostat","national migration statistics"],"links":["population","labour-demography","diaspora","housing"]},
    {"id":"foreign-direct-investment","label":"Foreign direct investment","unit":"currency / percent GDP","priority":"high","source_families":["OECD","UNCTAD","ECB","World Bank","national central banks"],"links":["ownership","finance","trade","technology"]},
    {"id":"bank-credit","label":"Private-sector bank credit","unit":"currency / percent GDP","priority":"high","source_families":["BIS","ECB","IMF","central banks"],"links":["finance-banking","housing","business-investment","public-finance"]},
    {"id":"pension-assets","label":"Pension assets","unit":"currency / percent GDP","priority":"high","source_families":["OECD","EIOPA","national regulators"],"links":["insurance-pensions","demography","capital-markets","public-finance"]},
    {"id":"housing-cost","label":"Housing cost burden","unit":"percent of disposable income","priority":"high","source_families":["Eurostat","OECD","national statistics"],"links":["housing-real-estate","households","wages","finance"]},
    {"id":"food-dependence","label":"Food import dependence","unit":"share / index","priority":"high","source_families":["FAO","Eurostat","UN Comtrade","national agriculture agencies"],"links":["agriculture","food-processing","trade","logistics"]},
    {"id":"critical-minerals","label":"Critical-material import concentration","unit":"share / Herfindahl-type index","priority":"high","source_families":["Eurostat","UN Comtrade","IEA","USGS"],"links":["mining-raw-materials","manufacturing","semiconductors","defence"]},
    {"id":"defence-spending","label":"Defence expenditure","unit":"currency / percent GDP / per capita","priority":"high","source_families":["NATO","SIPRI","national defence ministries"],"links":["defence-security","aerospace-defence","public-finance","industry"]},
    {"id":"government-digital","label":"Digital public-service maturity","unit":"index / score","priority":"medium-high","source_families":["UN E-Government Survey","OECD","European Commission"],"links":["public-administration","software-ai","telecoms-connectivity"]}
  ],
  "coverage_policy":{"country_count":195,"minimum_release_fields":["population","gdp","gdp_per_capita","debt_to_gdp","trade","energy_mix","religious_composition","political_system"],"preferred_full_fields":"All blueprint fields should eventually receive observations, historical snapshots or explicit missing states.","quality_states":["sourced","calculated","estimated","scenario","researched_missing","not_researched","conflicting"],"rule":"Never convert an empty field into zero, and never count an overlay file as empirical enrichment."},
  "derived_metrics":[
    {"id":"debt-per-capita","formula":"general_government_gross_debt / population","requires":["public-debt","population"]},
    {"id":"government-spending-per-capita","formula":"government_expenditure / population","requires":["government-expenditure","population"]},
    {"id":"tax-to-gdp","formula":"tax_revenue / GDP","requires":["government-revenue","gdp"]},
    {"id":"trade-to-gdp","formula":"exports_plus_imports / GDP","requires":["trade","gdp"]},
    {"id":"research-intensity","formula":"R&D expenditure / GDP","requires":["rd-spending","gdp"]},
    {"id":"dependency-load","formula":"working_age_population / dependent_population","requires":["population","median-age"]}
  ]
}
