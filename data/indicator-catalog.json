    {"id":"researchers","label":"Researchers","unit":"FTE / persons","priority":"high","source_families":["Eurostat","OECD","UNESCO","national science agencies"],"links":["research-innovation","education-skills","labour"]},
    {"id":"patents","label":"Patent activity","unit":"applications / grants","priority":"medium-high","source_families":["WIPO","EPO","national patent offices"],"links":["research-innovation","technology","industry"]},
