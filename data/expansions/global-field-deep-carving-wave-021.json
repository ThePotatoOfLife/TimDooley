{
  "id": "wave-021",
  "title": "Global Field Deep Carving — ontology, evidence, systems, couplings and real-data anchors",
  "date": "2026-09-07",
  "status": "additive-research-layer",
  "purpose": "Deepen weak or thin regions across the repository without moving the canonical Frame. This wave treats the repository as a relationship-first atlas of reality, culture, religion, politics, economy, ecology, technology, institutions, history and the project mythology.",
  "canonical_rule": "Do not reorder data/tree.json. Add depth beneath existing levels. Keep empirical, historical, mathematical, comparative and project-symbolic claims distinct.",
  "coverage_strategy": {
    "method": "carve-existing-branches-first",
    "passes": [
      "inspect-current-state",
      "identify-thin-concepts",
      "add reusable stacks",
      "add cross-domain couplings",
      "replace vague placeholders with observable data structures",
      "attach source and time requirements",
      "leave uncertain claims explicitly uncertain",
      "promote only after evidence and graph role are clear"
    ],
    "weaknesses_found": [
      "The World branch has broad nouns but needs finer system decomposition.",
      "The North Programme has strong sector names but needs country-by-country system stacks and cross-border dependency edges.",
      "Religion needs the same depth for every tradition that Christianity is beginning to receive.",
      "Politics needs explicit separation between ideas, organizations, elections, office-holding and outcomes.",
      "Culture needs transmission, production, consumption, geography and generation layers.",
      "History needs an event ledger connected to institutions, people, places, resources and consequences.",
      "Ownership and obligations need first-class claim and control models.",
      "Infrastructure needs physical-network, operator, capacity, bottleneck, maintenance and dependency layers.",
      "Science and technology need discovery, institution, funding, publication, patent, production and deployment chains.",
      "Evidence needs source hierarchy, observation date, publication date, extraction date, uncertainty and contradiction handling.",
      "The graph needs more explicit temporal and spatial semantics.",
      "The mythology needs richer internal relations while remaining clearly separated from empirical claims."
    ]
  },
  "universal_stack": {
    "description": "Reusable stack that can be applied to a religion, ideology, country, institution, company, movement, technology, historical event, cultural system or infrastructure asset.",
    "layers": [
      {"id":"existence","question":"What is it?","fields":["id","type","name","aliases","status","scope"]},
      {"id":"identity","question":"How is it named and recognized?","fields":["self-description","external-classification","alternative-names","boundary-cases"]},
      {"id":"history","question":"How did it become what it is?","fields":["origin","predecessors","founding-events","splits","mergers","reforms","decline","revival"]},
      {"id":"ideas","question":"What does it claim or value?","fields":["concepts","beliefs","norms","goals","principles","doctrines"]},
      {"id":"sources","question":"What evidence or texts anchor it?","fields":["primary-sources","secondary-sources","archives","datasets","law","statistics"]},
      {"id":"interpretation","question":"How are sources understood?","fields":["schools","commentary","contested-readings","method","tradition"]},
      {"id":"practice","question":"What happens in lived reality?","fields":["ritual","behavior","production","consumption","attendance","participation"]},
      {"id":"organization","question":"How is it organized?","fields":["leadership","membership","governance","branches","local-units","networks"]},
      {"id":"population","question":"Who participates?","fields":["affiliation","membership","active-participation","age","sex","education","income","migration"]},
      {"id":"geography","question":"Where does it exist?","fields":["country","region","city","rural-urban","diaspora","migration-route"]},
      {"id":"institutions","question":"Which durable organizations carry it?","fields":["schools","hospitals","media","charities","companies","government-bodies","associations"]},
      {"id":"material","question":"What physical and financial substrate supports it?","fields":["land","buildings","equipment","money","labor","energy","transport","digital-infrastructure"]},
      {"id":"power","question":"Who can decide, allocate, constrain or veto?","fields":["authority","law","capital","votes","coercion","expertise","agenda-setting","network-position"]},
      {"id":"network","question":"What does it connect to?","fields":["allies","opponents","suppliers","customers","funders","teachers","media","regulators","diaspora"]},
      {"id":"change","question":"How is it changing?","fields":["growth","decline","switching","migration","innovation","conflict","institutionalization","fragmentation"]},
      {"id":"evidence","question":"How do we know?","fields":["source","source-type","source-date","observation-date","last-verified","confidence","uncertainty","contradictions"]}
    ]
  },
