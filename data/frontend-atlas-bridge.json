  "route_map":{
    "home":"index.html",
    "public_door":"{door}/",
    "branch":"explore/#branch={id}",
    "record":"explore/#record={path}",
    "context":"explore/#context={id}",
    "pathway":"explore/#path={id}",
    "static_record":"records/{id}/",
    "static_topic":"topics/{id}/",
    "static_context":"context/{id}/"
  },
  "record_resolution":{
    "id_fields":["id","slug","country_id","countryId","key"],
    "name_fields":["name","title","label"],
    "alias_fields":["aliases","alternative_names","aka"],
    "description_fields":["description","summary","overview"],
    "relationship_fields":["relationships","edges","links"],
    "source_fields":["source_ids","sources","evidence","source"],
    "allowed_path_sources":["manifest.json","knowledge/indexes/canonical-record-registry.json","knowledge/indexes/context-graph.json"]
  },
  "fallback_policy":{
    "json_failure":"skip optional dataset and continue with canonical datasets",
    "country_failure":"use the canonical country record in data/countries/",
    "empty_description":"show record identity plus available relationships and evidence rather than a blank page"
  },
  "integrity_requirements":[
    "The homepage exposes exactly five primary public doors",
    "Rooms are secondary subject corridors and never additional primary Doors",
    "World is the fifth public domain; World Map, Politics, North and World Systems are specialist sibling routes beneath it",
    "Every major manifest branch has one explicit primary_door, global_route or backend_only projection state",
    "Canonical ownership remains in source/canonical records; this bridge owns routing intent only",
    "Mature public readers own their human-facing routes while Explore remains the deep archive browser",
    "Every relationship endpoint resolves or is explicitly marked unresolved",
    "Unknown data is represented as missing/unknown, never as zero",
    "Backend-only or research-heavy records remain discoverable without becoming homepage clutter",
    "Canonical IDs remain stable while aliases may expand",
    "Requested record paths are fetched only after resolving through an approved registry/manifest allowlist"
  ],
  "design_rule":"Five simple doors above, visible subject Rooms in the middle, one deep archive below. World is the public domain; specialist views project the same canonical backend without duplicating truth or exposing internal file organization as navigation."
}
