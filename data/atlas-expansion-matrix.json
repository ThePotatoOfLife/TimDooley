{
  "version":"1.0.0",
  "updated":"2026-09-07",
  "purpose":"Master expansion matrix for systematically populating the Tim Dooley Atlas. It turns broad research domains into concrete record families, measurements, relationships, evidence requirements and promotion targets.",
  "principle":"Do not merely add names. Add identity, definition, geography, timeline, function, scale, relationships, evidence, uncertainty and routeability.",
  "coverage_dimensions":["identity","definition","classification","history","geography","institutions","people","population","economics","finance","ownership","obligations","infrastructure","technology","energy","trade","security","law","culture","belief","environment","events","relationships","evidence","uncertainty","trajectory"],
  "expansion_domains":[
    {"id":"world-states","label":"States and territories","records":["195 sovereign-state records","territories","dependencies","constitutional structures","capitals","subnational structures"],"measurements":["population","area","GDP","GDP per capita","government revenue","government expenditure","debt","trade","energy","life expectancy","urbanization"],"edges":["member-of","borders","governs","trades-with","depends-on","supplies","funds","hosts","allies-with"]},
    {"id":"security-intelligence","label":"Intelligence and security","records":["intelligence agencies","security services","military intelligence","signals intelligence","financial intelligence","police","border agencies","oversight bodies","ministries","joint centres"],"measurements":["established","legal basis","budget when public","personnel when credible","jurisdiction","oversight","public mandate"],"edges":["agency-of","reports-to","overseen-by","liaises-with","shares-information-with","investigates","protects","operates-under-law"]},
    {"id":"extremism-terrorism","label":"Extremism, terrorism and hate groups","records":["terrorist organizations","hate groups","violent extremist networks","prison gangs","insurgent movements","historical organizations","successor organizations","controversial movements"],"measurements":["founding year","origin","public headquarters","chapters","active status","membership estimate","designation status","attacks","arrests"],"edges":["originated-in","designated-by","successor-of","splintered-from","active-in","inspired-by","opposed-by","investigated-by"],"guardrail":"Use source-specific classifications and dated estimates. Never turn an uncertain estimate into an exact membership count."},
    {"id":"religion-belief","label":"Religion and belief","records":["major traditions","denominations","schools","new religious movements","philosophies","texts","ritual systems","institutions","founders","historical movements"],"measurements":["founding period","geographic origin","estimated adherents when credible","institutional footprint","textual corpus"],"edges":["originated-from","influenced","split-from","contains-school","uses-text","institutionalized-by","practiced-in","interprets"]},
    {"id":"economy-finance","label":"Economic and financial system","records":["central banks","treasuries","commercial banks","asset managers","exchanges","payment systems","sovereign debt","corporate debt","currencies","funds","pension systems"],"measurements":["GDP","inflation","interest rates","debt","deficits","assets","liabilities","market capitalization","flows","ownership stakes"],"edges":["owns","lends-to","borrows-from","guarantees","clears-through","settles-through","invests-in","depends-on"]},
    {"id":"energy","label":"Energy system","records":["oil","gas","coal","nuclear","hydro","wind","solar","grids","interconnectors","storage","refineries","LNG terminals","pipelines","ports"],"measurements":["capacity","generation","imports","exports","consumption","reserve","price","interconnection capacity"],"edges":["supplies","imports-from","exports-to","connects-to","depends-on","owns","operates"]},
    {"id":"infrastructure","label":"Infrastructure","records":["ports","airports","railways","roads","bridges","tunnels","subsea cables","data centres","satellites","water systems","power grids","pipelines"],"measurements":["capacity","throughput","ownership","operator","location","criticality","redundancy"],"edges":["connects","operated-by","owned-by","depends-on","routes-through","supplies","bottlenecks"]},
