    {"id":"labour-demography","label":"People, labour and demography","records":["population","age structures","migration","labour markets","occupations","skills","education systems","households","cities"],"measurements":["population","fertility","life expectancy","employment","unemployment","participation","wages","migration flows","education attainment"],"edges":["migrates-to","works-in","educated-by","depends-on","supports","moves-through"]},
