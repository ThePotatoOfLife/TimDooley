{
  "version":"1.0.0",
  "status":"active-blueprint",
  "purpose":"Reusable country-data acquisition and normalization blueprint. Apply the same schema and source rules to every country so country records become comparable, refreshable and extensible without copying instructions into each country record.",
  "visibility":"backend-only",
  "entity":"country",
  "identity":{"required":["country_id","iso_alpha2","iso_alpha3","iso_numeric","name","official_name","capital","sovereignty_status","recognition_status"],"aliases":true,"historical_names":true,"source_priority":["national_authority","UN","ISO","World Bank"]},
  "geography":{"required":["continent","subregion","region","subnational_units","capital","major_cities","area_km2","land_area_km2","water_area_km2","coordinates","time_zones","borders","coastline_km","maritime_zones","territories","dependencies"],"classification_axes":["UN-region","UN-subregion","continent","North-South-East-West","Europe-Arctic-Atlantic-Mediterranean-Baltic","economic-region","cultural-region","religious-region","custom-project-region"],"multi_membership":true},
  "symbols_and_identity":{"required":["flag","coat_of_arms","national_symbols","anthem","motto","official_languages","national_language_policy","currency","national_day","official_religion_or_none"],"visual_assets":["flag","coat_of_arms","religious_symbol_if_official_or_relevant"],"royal_fields":["monarch","consort","royal_house","succession_rule","regnal_history","royal_signature_or_publicly_documented_signature_when_legally_or_historically_relevant"],"signature_rule":"Only use publicly documented historical/official signatures; never infer or manufacture a signature."},
  "population":{"required":["population","population_year","growth_rate","population_density","median_age","sex_ratio","urbanization","life_expectancy","birth_rate","death_rate","fertility","migration_stock","net_migration","citizenship_composition_when_available","age_structure","household_structure"],"subgroups":["age","sex","urban-rural","citizenship","birthplace","migration","language","ethnicity_or_ethnolinguistic_identity_only_when_publicly measured","indigenous_status_when officially measured","education","labour_status","income_distribution"],"privacy":"aggregate public statistics only; never infer private identity"},
  "economy":{"required":["gdp","gdp_year","gdp_per_capita","gdp_per_capita_ppp","real_growth","inflation","unemployment","labour_force_participation","productivity","current_account","exports","imports","trade_balance","government_revenue","government_expenditure","tax_revenue","public_investment","private_investment","savings","sectoral_value_added"],"sectors":["agriculture","manufacturing","construction","energy","mining","services","finance","technology","health","education","tourism","transport","communications"],"distribution":["median_income","income_quintiles","gini","poverty","wealth_when_reliable"]},
  "public_finance":{"required":["general_government_gross_debt","debt_to_gdp","central_government_debt","external_debt","domestic_debt","debt_service","interest_cost","revenue","expenditure","primary_balance","fiscal_balance","deficit_to_gdp","government_assets_when_available","contingent_liabilities","sovereign_credit_rating_when_available"],"debt_breakdown":["currency","maturity","fixed_variable","resident_nonresident","holder_type","government_level","instrument","interest_rate"],"fiscal_structure":["taxes","social_contributions","transfers","pensions","health","education","defence","infrastructure","interest","subsidies","administration"],"update_frequency":"prefer quarterly or annual official/IMF/Eurostat data"},
  "money_and_finance":{"required":["currency","central_bank","policy_rate","exchange_rate","reserves","money_supply","banking_assets","bank_credit","nonperforming_loans","financial_market_depth","stock_market","bond_market","foreign_exchange_regime","capital_controls_when_applicable","sovereign_yields"],"ownership_and_exposure":["foreign_assets","foreign_liabilities","fdi_inward","fdi_outward","portfolio_investment","external_position","major_public_financial_institutions"]},
  "political_system":{"required":["constitution","system_type","head_of_state","head_of_government","current_leader","leader_term","government_coalition","executive_structure","judiciary_structure","electoral_system","voting_age","eligibility_age","suffrage_status","next_election_when_known","last_election","political_parties","party_system","government_parties","opposition_parties","political_affiliations","international_political_groupings"],"composition":["parliament_chambers","seats","party_seats","independent_seats","women_seats","age_distribution","committee_structure","government_ministers","regional_representation","reserved_seats","turnout","vote_share","electoral_threshold","coalition_structure"],"politician_records":"Create separate public-office-holder records for current leaders, cabinet, parliamentary leadership and major publicly documented political figures; include office, party, term, election, biography and sources."},
  "parliament":{"source":"IPU Parline","fields":["structure","chambers","members","designation_method","directly_elected","indirectly_elected","appointed","women","men","age","reserved_seats","quotas","parties","government","elections","law_making","oversight","budget","administration","specialized_bodies","speakers","secretary_general","historical_series"],"refresh":"monthly/latest available; retain historical snapshots"},
  "monarchy_and_state_symbols":{"fields":["monarchy_status","monarch","royal_house","heir","regency","succession","royal_titles","constitutional_role","royal_estate_or_public_assets_when documented","royal_signatures","historic_monarchs"],"condition":"only applicable fields; do not force monarchy onto republics"},
  "religion":{"required":["religious_composition","religion_year","majority_or_plurality","official_state_religion","constitutional_religion_status","freedom_of_religion","religious_law_when applicable","religious_institutions"],"composition":["christianity","islam","hindu_traditions","buddhist_traditions","judaism","sikhism","jainism","bahai","daoist_traditions","shinto","zoroastrian_traditions","indigenous_traditions","folk_religions","other_religions","unaffiliated","atheist","agnostic","unknown"],"denominations":"Preserve denomination/tradition/school where public data supports it; do not manufacture precision.","demography":"separate affiliation, belief, practice, attendance, membership and switching when sources permit"},
  "society_and_culture":{"fields":["languages","religious_culture","family_patterns","education","literacy","media","internet_use","digital_platforms_when measurable","arts","sports","food","festivals","cultural_exports","diaspora","social_trust_when measured","civic_participation","volunteering","associational_life"],"identity_axes":"Use public aggregate measurements; avoid treating culture, ethnicity, nationality or religion as interchangeable."},
  "history":{"required":["ancient_history","pre_state_history","state_formation","constitutional_history","dynasties_or_regimes","colonial_history_when applicable","independence","wars","revolutions","borders","major_migrations","economic_transitions","religious_history","political_history","20th_century","21st_century","major_turning_points"],"event_schema":["date","period","event","actors","place","cause","resources","institutional_change","territorial_change","population_effect","legal_effect","economic_effect","long_term_consequence","sources"]},
  "military_and_security":{"required":["armed_forces","defence_budget","defence_budget_share_gdp","active_personnel","reserve_personnel","major_capabilities","air_power","naval_power","land_power","missile_capabilities_when_public","nuclear_status","cyber_capability_public_assessments","space_capability","defence_industry","arms_imports","arms_exports","alliances","bases_or_host_nation_presence_when public","mobilization_system"],"rule":"Use public, non-operational capability assessments; never expose classified personnel, locations, vulnerabilities or targeting information."},
  "intelligence_and_security_relationships":{"fields":["civilian_intelligence_services","military_intelligence_services","domestic_security_services","foreign_intelligence_services","oversight_bodies","legal_basis","international_intelligence_cooperation","formal_security_partnerships","publicly documented intelligence affiliations"],"rule":"Institutional/public relationship mapping only; no covert personnel, classified systems or operational methods."},
  "alliances_and_external_relations":{"fields":["UN","EU","NATO","OSCE","Council_of_Europe","AU","ASEAN","Arab_League","GCC","OAS","MERCOSUR","Commonwealth","Nordic_Council","G20","G7","BRICS","regional_bodies","bilateral_treaties","trade_agreements","defence_agreements","sanctions","diplomatic_relations","aid_relationships","development_partners"],"membership_is_time_sensitive":true},
  "trade_and_value_chains":{"fields":["top_exports","top_imports","trade_partners","export_concentration","import_concentration","critical_imports","critical_exports","supply_chain_dependencies","ports","shipping","rail","road","air_freight","customs","special_economic_zones","strategic_commodities","global_value_chain_positions"]},
  "energy":{"fields":["energy_mix","electricity_mix","primary_energy","oil","gas","coal","nuclear","hydro","wind","solar","biomass","geothermal","storage","grid_capacity","interconnectors","refineries","lng","imports","exports","energy_prices","energy_subsidies","emissions","energy_security","critical_dependencies"]},
  "natural_resources_and_ecology":{"fields":["land_use","agriculture","forests","freshwater","fisheries","minerals","critical_minerals","oil_gas_resources","biodiversity","protected_areas","climate_exposure","emissions","air_quality","water_quality","soil","desertification","natural_hazards","adaptation","restoration"],"resource_ownership":"Track public/private/foreign ownership when documented."},
  "infrastructure":{"fields":["electricity","gas","water","waste","roads","rail","ports","airports","telecom","mobile","fixed_broadband","submarine_cables","satellite","data_centres","pipelines","dams","housing","hospitals","schools","critical_infrastructure","capacity","operator","owner","maintenance","redundancy","bottlenecks"]},
  "science_technology_and_innovation":{"fields":["r_and_d_spending","researchers","universities","research_institutes","patents","scientific_output","citations","technology_exports","semiconductors","ai","biotech","space","quantum","cybersecurity","startup_ecosystem","venture_capital","industrial_research","technology_dependencies","research_partnerships"],"sources":"Use bibliometric, patent, official and institutional data; distinguish output from quality and funding."},
  "health":{"fields":["health_spending","doctors","nurses","beds","life_expectancy","mortality","maternal_mortality","infant_mortality","disease_burden","mental_health_when measured","vaccination","health_system_type","coverage","out_of_pocket","pharmaceutical_industry","medical_trade","health_workforce"]},
  "education":{"fields":["education_spending","enrolment","literacy","completion","tertiary_education","vocational_education","universities","research","student_mobility","international_students","teacher_workforce","learning_outcomes","skills","migration_of_skilled_workers"]},
  "labour":{"fields":["employment","unemployment","participation","wages","minimum_wage","collective_bargaining","union_density","working_hours","informality","occupational_structure","skills","labour_shortages","migration","productivity","female_participation","youth_employment","retirement_age"]},
  "law_and_rights":{"fields":["constitution","legal_family","civil_law","common_law","religious_law","administrative_law","criminal_law","courts","constitutional_review","human_rights_framework","press_freedom","religious_freedom","assembly","association","property_rights","rule_of_law","corruption_measures","international_court_membership"],"rule":"Describe legal status and measured indicators; do not infer rights from reputation alone."},
  "media_information_and_digital_ecosystem":{"fields":["media_system","public_broadcaster","major_media","press_freedom","internet_penetration","social_media_use","digital_government","content_regulation","platform_presence","information_integrity_indicators","cyber_policy","data_protection","ai_regulation","telecommunications_market"]},
  "migration_and_diaspora":{"fields":["immigrant_population","emigration","diaspora","refugees","asylum","citizenship","naturalization","remittances","migration_corridors","skills_migration","return_migration","border_policy","integration_policy"],"privacy":"aggregate population data only"},
  "ownership_and_control":{"fields":["state_owned_enterprises","largest_companies","beneficial_ownership_when public","foreign_ownership","sovereign_wealth","pension_assets","bank_ownership","strategic_asset_ownership","land_ownership_when public","licensing","concessions","procurement","control_relationships"],"rule":"Use public registers/filings and aggregate where individual privacy applies."},
  "public_administration":{"fields":["government_levels","ministries","civil_service","public_employment","administrative_regions","budgets","procurement","state_capacity_indicators","e_government","public_assets","regulators","independent_agencies","audit_institutions","ombudsman","anti_corruption_bodies"]},
  "housing_and_living_conditions":{"fields":["housing_stock","home_ownership","rents","house_prices","overcrowding","homelessness_when measured","utilities_access","energy_poverty","food_security","poverty","social_protection","inequality"]},
  "transport_and_mobility":{"fields":["roads","rail","high_speed_rail","public_transport","ports","airports","vehicle_fleet","freight","passenger_flows","border_crossings","logistics","shipping","aviation","mobility_dependencies"]},
  "international_position":{"fields":["diplomatic_network","foreign_aid","aid_received","trade_dependency","financial_dependency","security_dependency","technology_dependency","energy_dependency","food_dependency","critical_mineral_dependency","strategic_autonomy_indicators","global_rankings_when methodological"]},
  "temporal_model":{"every_field":"store value, unit, reference_period, publication_date, last_verified, next_expected_update, source, source_url, confidence, methodology, notes","history":"retain historical snapshots rather than overwriting previous values","forecast":"separate observed, estimated, projected and scenario values"},
  "provenance":{"required_per_value":["source","source_type","publication_date","reference_period","retrieved_at","last_verified","methodology","confidence","revision_status"],"source_priority":["national_statistics","central_bank","national_ministry/agency","international_organization","parliamentary/institutional source","academic dataset","reputable reporting","secondary database"],"conflicts":"retain competing values with provenance rather than silently selecting one"},
  "relationships":{"generate_edges":["country-belongs-to-region","country-borders-country","country-member-of-organization","country-trades-with-country","country-depends-on-country","country-allied-with-country","country-governed-by-government","party-governs-country","leader-holds-office","religion-present-in-country","denomination-present-in-country","company-operates-in-country","infrastructure-connects-country","energy-flows-to-country","migration-flows-between-countries","country-owns-asset","country-regulates-sector","country-funds-institution","country-participates-in-war","country-signed-treaty","country-has-diaspora-in-country"],"validity":"time-bounded edges where membership, leadership, alliances or ownership can change"},
  "derived_views":{"compute":["debt_to_gdp","debt_per_capita","gdp_per_capita","government_spending_per_capita","tax_to_gdp","defence_spending_per_capita","energy_dependence","trade_dependence","population_growth","dependency_ratio","labour_dependency","religious_composition_shares","parliamentary_composition","party_system_concentration","electoral_turnout","foreign_trade_concentration","critical_import_concentration","alliance_centrality","network_centrality","north_south_east_west_membership"],"rule":"Derived metrics must retain their input values and formula."},
  "symbolic_project_layer":{"fields":["axis_position","north_south_east_west","tree_position","tree_of_life_relationship","tree_of_strife_relationship","project_symbolism","comparative_mythology"],"epistemic_status":"project-interpretation only; never merge with empirical country statistics","requested_population_metaphors":["angel/demon language may exist only as explicit symbolic/project categories and must never be presented as demographic fact or assigned to real people" ]},
  "automation":{"pipeline":["discover source","fetch","parse","normalize","validate","compare with prior snapshot","store raw source metadata","store normalized value","calculate derived fields","update relationship edges","flag conflicts","record last_verified","publish country record","surface stale/missing fields"],"schedules":{"fast":"daily/weekly for leaders, markets, elections and high-volatility indicators","medium":"monthly for political, parliamentary, energy and financial fields","slow":"quarterly/annual for demographics, GDP, debt, religion and structural indicators","historical":"on source revision or periodic backfill"},"failure_mode":"Never replace a valid value with null because a source failed. Preserve previous value and mark stale."},
  "quality_control":{"checks":["ISO identity validation","unit validation","year validation","duplicate country detection","source presence","outlier detection","missingness report","cross-source reconciliation","time-series discontinuity","relationship integrity","privacy review","epistemic-status review","manual review for major political changes"],"confidence_levels":["primary-official","international-official","academic","reputable-secondary","estimated","project-interpretive"],"sensitive_fields":"No private addresses, private contact details, private financial information, classified intelligence or inferred personal beliefs."},
  "country_record_output":{"required_sections":["identity","map","symbols","population","economy","public_finance","politics","parliament","leadership","monarchy_if_applicable","religion","history","military","security","alliances","trade","energy","resources","infrastructure","science_technology","health","education","labour","law_rights","media_digital","migration","ownership","administration","housing","transport","international_position","relationships","sources","data_freshness"],"frontend":"Country pages consume normalized data generated from this blueprint; blueprint instructions remain backend-only."}
}
