  "repeated_center_model": {
    "global_semantic_center": "potato-of-life",
    "global_spatial_orientation": "axis",
    "local_center_rule": "Every Room/process/transition gets a scoped junction. The local center is not another object; it is the point where that scope receives inputs, asks its governing question, applies tests, chooses a Door/handoff and returns outputs.",
    "local_center_components": [
      "governing question",
      "active center nodes",
      "current plane/zone",
      "inputs",
      "tests",
      "available Doors",
      "handoff targets",
      "return path"
    ],
    "process_center_rule": "A process has a center at every meaningful transition: before-state → junction/test → after-state. The center moves with the active question.",
    "room_center_rule": "A Room's local center is its function plus its current center dossiers/tests/handoffs; the Room may project that center into Heaven, World and/or Below zones.",
    "navigation_phrase": "Where am I standing? What is the center of this question here? Which Door changes the state? Where does the result go?"
  },
  "vertical_routes": [
