      ],
      "meaning": "Unintegrated knowledge/history can descend into repeated conflict and capture."
    },
    {
      "id": "repair-rise",
      "route": [
        "below:swamp/ash-mud",
        "below:forge",
        "below:seed-bed",
        "world:research-workshop/world-gates",
        "heaven:garden/orchard",
        "world:return"
      ],
      "meaning": "Repair begins Below, transforms residue in Forge, reopens growth and returns evaluated Fruit to the World."
    }
  ]
