{
  "id": "reader-richness-audit",
  "version": "1.0.0",
  "updated": "2026-09-20",
  "purpose": "Measure whether reader-facing HTML surfaces feel inhabited rather than merely navigational, and drive a systematic enrichment programme.",
  "thesis": "The project is not poor in knowledge; it is poor where backend knowledge fails to project into the page. Richness means useful density, not card count.",
  "quality_contract": {
    "minimum_experience": [
      "orientation: what this page is and why it matters",
      "substance: at least one concrete explanation rather than category labels alone",
      "specificity: named objects, dates, mechanisms, works, cases, evidence or claims owned by the page",
      "development: what changes over time or across states",
      "boundary: what the page does not establish",
      "depth: routes into actual canonical holdings or sources",
      "continuity: links that feel like conceptual continuation rather than a generic footer"
    ],
    "preferred_editorial_forms": [
      "continuous prose",
      "dated narrative",
      "annotated examples",
      "short declarative runs",
      "case/object lists",
      "source doors",
      "questions with substantive answers",
      "tables only where comparison genuinely benefits"
    ],
    "anti_patterns": [
      "title + one-sentence summary + adjacent-room cards",
      "repeated In scope for this bounded context labels",
      "large grids where every card has equal visual weight",
      "generic definitions that could belong to any website",
      "link directories with no explanation of why a reader should care",
      "backend richness that never reaches the public surface"
    ]
  },
  "thresholds": {
    "critical_under_bytes": 2500,
    "thin_under_bytes": 9000,
    "note": "Byte size is only a screening signal. Redirects, loaders and deliberate micro-pages may be correctly small; qualitative review decides enrichment."
  },
  "scan": {
    "eligible_pages": 122,
    "critical_pages": 25,
    "thin_pages": 49,
    "medium_pages": 28,
    "rich_pages": 20
  },
