{
  "id": "substance-first-projection-contract",
  "title": "Substance-First Public Projection Contract",
  "version": "1.0.0",
  "updated": "2026-09-20",
  "status": "binding presentation/materialization contract",
  "purpose": "Make reader-facing substance the first-class public experience while preserving quiet, typed, machine-readable bonds to canonical owners, Rooms, provenance and evidence boundaries underneath the prose.",
  "paradox_resolution": {
    "frontend_priority": "A public reader page must first be worth reading on its own. Authored explanation, examples, dates, mechanisms, cases, numbers, quotations, disputes and consequences outrank navigation scaffolding and generic projection copy.",
    "backend_authority": "Durable definitions, evidence, provenance, typed relations and revision state remain owned by canonical backend records. The public page is a living projection, not a competing source of truth.",
    "invisible_bonds": "Public prose may be quietly bound to backend owners through build-injected machine-readable bindings. These bonds support traceability, discovery and review without forcing visible cards, filenames or schema language into the reading flow.",
    "non_constraint": "Bindings do not generate, order, shorten or rewrite authored prose. Validators check that bindings resolve and that enriched sections still exist; they do not enforce paragraph templates, card counts, exact word counts or a single visual form.",
    "bidirectional_revision": "Backend changes may flag a bound public section for editorial review, but must not overwrite it automatically. Frontend questions or contradictions may expose missing backend ownership; the repair is to strengthen the durable owner and then revise prose deliberately.",
    "materialization_rule": "A backend object is not fully public-materialized merely because a route exists. Its public projection must expose enough concrete substance that a reader can learn something without opening repository governance or raw JSON."
  },
  "principles": [
    "Spend the archive on the page instead of merely pointing at it.",
    "Substance before scaffolding; scaffolding should disappear when the prose is read aloud.",
    "Use links as optional doors inside meaningful sentences, not as substitutes for explanation.",
    "Prefer named objects, dates, mechanisms, texts, measurements, cases, conflicts, evidence classes and consequences over generic category prose.",
    "Let one frontend paragraph bind to several backend owners when the synthesis genuinely crosses Rooms.",
    "Never make one backend schema dictate the rhetorical shape of every public page.",
    "Preserve disagreement and uncertainty in bindings rather than smoothing them out in the frontend.",
    "A visible page may synthesize; canonical owners remain responsible for source truth and revision history."
  ],
  "binding_model": {
    "deployment_surface": "The build injects a non-visible application/json block into registered public pages.",
    "html_marker": "data-house-substance-bindings",
    "page_attribute": "data-substance-policy=\"substance-first\"",
    "binding_fields": [
      "page",
      "rooms",
      "anchors",
      "owner_paths",
      "relation_types",
      "evidence_classes",
      "review_triggers"
    ],
    "review_triggers": [
      "canonical owner changes materially",
      "evidence class changes",
      "a bound claim is corrected or withdrawn",
      "a public section disappears",
      "a new contradiction changes the synthesis"
    ]
  },
