    {
      "id": "fruit-test",
      "question": "What changed downstream?",
      "applies_to": [
        "organism",
        "spirit-relation",
        "memory-history",
        "culture-formation"
      ],
      "positive_signs": [
        "increased capacity",
        "clearer provenance",
        "better correction",
        "nourishment",
        "independent future growth"
      ],
      "negative_signs": [
        "dependency",
        "repetition without correction",
        "lost provenance",
        "blocked exit",
        "decreased agency"
      ]
    },
    {
      "id": "door-test",
      "question": "Did a real state/context/capability transition occur?",
      "applies_to": [
        "organism",
        "spirit-relation",
        "memory-history",
        "culture-formation"
      ]
    },
    {
      "id": "spiral-test",
      "question": "What is different this recurrence besides elapsed time?",
      "applies_to": [
        "organism",
        "memory-history",
        "culture-formation"
      ]
    },
    {
      "id": "garden-test",
      "question": "Does the system leave others more capable of independent future growth?",
      "applies_to": [
        "spirit-relation",
        "culture-formation",
        "organism"
      ]
    }
