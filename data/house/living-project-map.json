  "interfaces": [
    {
      "from": "organism",
      "to": "spirit-relation",
      "type": "embodiment-boundary",
      "question": "Which flows are literal physiology and which are project-theological or symbolic relation?",
      "rule": "Physical carriers may illuminate but do not prove Spirit."
    },
    {
      "from": "spirit-relation",
      "to": "memory-history",
      "type": "continuity-through-time",
      "question": "What carries meaning forward without rewriting earlier states?",
      "rule": "Continuity requires provenance; living reinterpretation may add meaning but must preserve developmental genealogy."
    },
    {
      "from": "memory-history",
      "to": "culture-formation",
      "type": "inheritance",
      "question": "How do archives and stories become social memory, roles and institutions?",
      "rule": "Inherited memory should carry source context and correction capacity."
    },
    {
      "from": "culture-formation",
      "to": "organism",
      "type": "conditions-of-life",
      "question": "How do institutions, communities and information environments affect bodies, behavior and future capacity?",
      "rule": "Social metaphor must not replace medical or biological evidence."
    },
    {
      "from": "culture-formation",
      "to": "spirit-relation",
      "type": "communication-and-community",
      "question": "When does relation become living reciprocity versus coercive dependency?",
      "rule": "Spirit language does not sanctify authority; Fruit, reciprocity and meaningful exit remain tests."
    },
    {
      "from": "organism",
      "to": "memory-history",
      "type": "development",
      "question": "How do dormancy, growth, injury and repair become dated developmental sequences?",
      "rule": "Biological lifecycle comparison must remain separate from biography or theology."
    }
  ],
