  "status": "canonical routing and consolidation registry",
  "purpose": "Consolidate the repository's recurring Potato operators by assigning one durable definition/contract owner, then routing specialist atlases, research comparisons, archaeology/provenance and public views underneath that owner. Prevent filename proliferation from becoming ontology proliferation.",
  "research_principles": [
    {
      "principle": "chart-not-whole",
      "statement": "A projection/view can reveal a real part of an object without being the object itself. Multiple compatible views may cover one underlying structure.",
      "comparator": "mathematical manifold atlas / local charts",
      "source": "https://encyclopediaofmath.org/wiki/Differentiable_manifold",
      "project_use": "House, Body, Tree, City, Plane and other Views remain projections over canonical owners rather than rival ontologies."
    },
    {
      "principle": "provenance-before-promotion",
      "statement": "Derived entities should retain the entities/activities from which they were produced.",
      "comparator": "W3C PROV",
      "source": "https://www.w3.org/TR/prov-primer/",
      "project_use": "Research synthesis and reader pages must point back to canonical/specialist/source owners instead of copying claims without lineage."
    }
  ],
  "file_role_precedence": [
    "canonical_contract",
    "canonical_definition_owner",
    "specialist_owner",
    "research_comparator",
    "timeline_or_archaeology",
    "reader_projection",
    "temporary_wave"
  ],
