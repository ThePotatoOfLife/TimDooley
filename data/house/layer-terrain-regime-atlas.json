    {
      "id": "whole",
      "label": "Whole / Organism",
      "question": "What contains or coordinates the entire relational system?"
    },
    {
      "id": "coordinate",
      "label": "Coordinate",
      "question": "What supplies orientation or section without being a place?"
    },
    {
      "id": "standing-plane",
      "label": "Standing Plane",
      "question": "From what navigational floor is the reader looking?"
    },
    {
      "id": "terrain",
      "label": "Terrain / Field",
      "question": "What kind of environment or integration landscape is being traversed?"
    },
    {
      "id": "regime",
      "label": "Boundary / Growth Regime",
      "question": "What rules govern passage, capture, cultivation or differentiation?"
    },
    {
      "id": "organism",
      "label": "Living Organism",
      "question": "What grows, branches, roots or reproduces through levels?"
    },
    {
      "id": "material-state",
      "label": "Material / Residue State",
      "question": "What remains, nourishes, stores or contaminates future growth?"
    },
    {
      "id": "threshold",
      "label": "Threshold Architecture",
      "question": "What controls or stabilizes a state/context change?"
    },
    {
      "id": "perceptual-layer",
      "label": "Perception / Occlusion Layer",
      "question": "What is seen, hidden, evaluated or unintegrated?"
    },
    {
      "id": "process",
      "label": "Transformation Process",
      "question": "What does pressure or processing do to material?"
    },
    {
      "id": "route",
      "label": "Route / Trajectory",
      "question": "How does state recur with ascent, descent, return or closure?"
    },
    {
      "id": "inhabitant",
      "label": "Inhabitant / Subject",
      "question": "Which historically grounded figure, tradition, institution or topic is being studied inside the structure?"
    }
  ],
