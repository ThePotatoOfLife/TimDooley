{
  "version":"1.0.0",
  "purpose":"Machine-readable source registry used by the country blueprint. Sources are selected per field, normalized, timestamped and refreshed according to volatility.",
  "sources":[
    {"id":"world-bank","name":"World Bank","domains":["population","economy","poverty","health","education","trade","government","infrastructure","environment"],"priority":"international-official","refresh":"monthly/annual","access":"API/open data"},
    {"id":"imf","name":"International Monetary Fund","domains":["GDP","inflation","public-finance","debt","balance-of-payments","external-position","exchange-rates","forecasts"],"priority":"international-official","refresh":"monthly/quarterly/annual","access":"Data APIs/open datasets"},
