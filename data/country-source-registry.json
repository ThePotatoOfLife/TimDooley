    {"id":"oecd","name":"OECD","domains":["tax","economy","education","labour","health","governance","productivity","innovation"],"priority":"international-official","refresh":"monthly/annual","access":"OECD data"},
    {"id":"eurostat","name":"Eurostat","domains":["EU-economy","public-finance","population","trade","labour","energy","regional-data"],"priority":"regional-official","refresh":"monthly/quarterly/annual","access":"API/open data"},
    {"id":"national-statistics","name":"National statistical offices","domains":["all national official statistics"],"priority":"primary-official","refresh":"field-dependent","access":"country-specific official APIs/downloads"},
    {"id":"central-bank","name":"National central banks","domains":["rates","currency","reserves","banking","financial-stability","external-position"],"priority":"primary-official","refresh":"daily/monthly/quarterly","access":"country-specific official data"},
