    {"id":"unctad","name":"UN Trade and Development","domains":["trade","investment","FDI","shipping","commodities","development"],"priority":"international-official","refresh":"annual/quarterly","access":"UNCTADstat"},
    {"id":"iea","name":"International Energy Agency","domains":["energy","electricity","oil","gas","coal","renewables","emissions","energy-security"],"priority":"international/intergovernmental","refresh":"monthly/annual","access":"published datasets"},
