  "selection_rules":["Prefer the primary national source when available.","Use international datasets for comparability and cross-checking.","Store both source-specific and normalized values when methodologies differ.","Never silently merge incompatible definitions.","When a source stops updating, preserve historical observations and mark the field stale rather than deleting it."],
  "refresh_rules":{"leaders/elections":"event-driven","parliament":"monthly","markets/rates":"daily or monthly","trade/energy":"monthly where available","GDP/debt/labour":"quarterly/annual","population/religion/structural-demography":"annual/periodic","history":"append-only research updates"}
