    {"id":"who","name":"World Health Organization","domains":["health","mortality","disease","health-workforce","health-spending"],"priority":"international-official","refresh":"periodic","access":"API/open data"},
    {"id":"ilo","name":"International Labour Organization","domains":["employment","unemployment","wages","labour-force","working-hours","migration","social-protection"],"priority":"international-official","refresh":"annual/monthly depending field","access":"ILOSTAT"},
    {"id":"unesco","name":"UNESCO Institute for Statistics","domains":["education","research","culture","science"],"priority":"international-official","refresh":"annual/periodic","access":"open data"},
    {"id":"unhcr","name":"UNHCR","domains":["refugees","asylum","displacement","statelessness"],"priority":"international-official","refresh":"annual/quarterly","access":"Refugee Data Finder"},
    {"id":"itu","name":"International Telecommunication Union","domains":["telecom","internet","mobile","broadband","digital-development"],"priority":"international-official","refresh":"annual","access":"ITU data"},
