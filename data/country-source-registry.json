    {"id":"ipu-parline","name":"Inter-Parliamentary Union Parline","domains":["parliament","elections","members","party-composition","women","age","speakers","legislative-structure"],"priority":"institutional-primary","refresh":"monthly/latest","access":"API/open data"},
