  "comparison":{"dimensions":["ultimate_reality","cosmology","anthropology","problem","salvation_or_liberation","ethics","textual_authority","ritual","leadership","organization","sacred_space","state_relationship","population","culture","material_base","historical_trajectory"],"rule":"Comparison is an analytical layer; preserve native categories underneath it."},
  "automation":{"refresh_classes":{"demography":"annual/when-new-census-or-survey","leadership":"weekly/monthly where public feeds permit","legal_status":"on legal change","institutions":"monthly/quarterly","membership":"on new published estimate","historical":"curated research","texts":"on corpus/version change","archaeology":"on major publication","heritage":"annual/event-driven"},"pipeline":["discover source","fetch","normalize","validate","compare previous snapshot","store provenance","derive shares/relationships","flag conflicts","publish","mark stale fields"],"historical_snapshots":true},
  "integrity_rules":["religion is not ethnicity","affiliation is not belief","membership is not attendance","denomination is not theology alone","historical tradition is not identical to modern institution","symbolic/esoteric material is not automatically empirical","country presence is not universal individual adherence","missing data is not evidence of absence","sacred claim is not empirical proof","later tradition is not automatically evidence for earlier history","institutional self-report is not independent corroboration","archaeological evidence does not prove theological interpretation"]
