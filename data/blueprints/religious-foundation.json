{
  "version":"1.0.0","status":"active-blueprint","visibility":"backend-only","entity":"religious-foundation",
  "purpose":"Reusable research specification for a religion or religious family. It is deliberately deeper than demographic affiliation: it maps worldview, texts, theology, ritual, institutions, people, places, material base, history and evidence.",
  "identity":{"required":["id","name","self_description","aliases","family","tradition_status","geographic_scope"],"classification":"family → tradition → school/denomination → institution → congregation/community → practitioner"},
  "origin_and_history":{"fields":["emergence_period","founding_or_formative_figures","predecessors","historical_context","early_texts","expansion","migration","state_relationship","major_splits","reforms","revivals","decline_or_secularization","modern_transformation","diaspora_history"],"date_rule":"Use approximate periods where no single foundation date exists; distinguish traditional sacred chronology from historical reconstruction."},
  "ultimate_reality":{"fields":["god_model","ultimate_reality","monotheism","polytheism","henotheism","panentheism","pantheism","non_theism","animism","ancestor_relations","divine_personhood","impersonal_absolute","sacred_natural_world"],"rule":"Do not force non-Western traditions into a Christian-style deity taxonomy."},
  "cosmology":{"fields":["creation","cosmic_order","worlds_or_realms","heaven","hell","underworld","spirits","angels_or_intermediaries","demons_or_chaotic_beings","sacred_geography","cyclical_or_linear_time","cosmic_cycles","human_place_in_cosmos"]},
  "anthropology_and_problem":{"fields":["human_nature","body","soul_or_self","mind","sin","ignorance","suffering","desire","karma","impurity","alienation","death","social_disorder","evil","problem_definition"]},
  "salvation_or_liberation":{"fields":["salvation_model","liberation_model","enlightenment","union_with_divine","rebirth","resurrection","grace","faith","works","knowledge","devotion","ritual_participation","repentance","ethical_transformation","community_membership"],"comparison_rule":"Keep each tradition's own categories before applying comparative labels."},
  "ethics_and_law":{"fields":["moral_principles","virtues","vices","commandments","religious_law","dietary_rules","sexual_ethics","family_ethics","charity","justice","war","peace","property","work","environment","care_for_poor","forgiveness","punishment","repentance"]},
  "texts_and_authority":{"fields":["canon","sacred_texts","oral_tradition","liturgical_texts","commentaries","creeds","legal_texts","philosophical_texts","hagiography","mythic_texts","manuscript_history","translation_history","textual_variants","authority_structure"],"canon_rule":"Canon is a relationship between a community and texts; record canon variants rather than one universal list."},
  "interpretation":{"fields":["schools","commentaries","hermeneutics","jurisprudence","theological_disputes","philosophical_schools","mystical_interpretation","literalist_interpretation","historical_critical_interpretation","modern_reinterpretation","boundary_disputes"]},
  "ritual_and_practice":{"fields":["daily_prayer","weekly_worship","meditation","sacrifice","sacrament","baptism_or_initiation","communion_or_shared_meal","fasting","pilgrimage","festival","mourning","burial","marriage","birth_rites","coming_of_age","confession","charity","diet","dress","sacred_music","dance","icon_or_image_practice","holy_days","calendar"]},
  "leadership_and_specialists":{"fields":["clergy","priests","rabbis","imams","monks","nuns","gurus","teachers","elders","shamans_or_specialists","prophets","bishops","patriarchs","popes","jurists","scholars","lay_leadership","ordination","succession","authority_limits"]},
  "organization":{"fields":["global_body","regional_bodies","national_bodies","dioceses_or_equivalents","local_congregations","monasteries","orders","seminaries","schools","universities","charities","hospitals","foundations","media","publishers","pilgrimage_institutions","cemeteries","archives"]},
  "population":{"fields":["global_affiliation","country_affiliation","self_identification","active_membership","registered_members","attendance","practice_frequency","doctrinal_adherence","conversion","deconversion","switching","age","sex","education","income","occupation","urbanization","migration","generation"],"integrity":"Affiliation is not the same as belief intensity or practice."},
  "denominations_and_schools":{"fields":["parent_tradition","school_type","theological_position","ritual_difference","legal_difference","authority_difference","founding_period","founder_or_formative_figures","geographic_base","current_presence","membership","institutional_network","splits","mergers","relations_to_parent"]},
  "sacred_space":{"fields":["holy_cities","temples","churches","mosques","synagogues","shrines","mountains","rivers","pilgrimage_routes","cemeteries","monasteries","sacred_land","archaeological_sites","diaspora_sites"],"geography":"Use public locations and aggregate institutional geography."},
  "material_and_economic_base":{"fields":["property","land","buildings","donations","tithes","endowments","waqf","charitable_assets","schools","hospitals","employment","publishing","media","tourism","pilgrimage_economy","procurement","tax_status","financial_reports_when_public"]},
  "state_and_law":{"fields":["official_religion","constitutional_status","religious_freedom","registration","religious_courts","personal_status_law","education_policy","clergy_recognition","tax_status","property_rights","public_funding","restrictions","state_church_relationship","secularization","religious_law_influence"]},
  "politics_and_power":{"fields":["political_participation","parties","movements","lobbying","public_office_holders","voting_patterns_when measured","state_alliance","opposition","religious_nationalism","political_theology","civil_society","international_networks"],"rule":"Map institutional and aggregate evidence; do not infer an individual's political belief from religious affiliation."},
  "culture_and_transmission":{"fields":["language","literature","music","art","architecture","food","dress","family","education","festivals","calendar","media","film","digital_communities","humor","national_identity","diaspora_culture","intergenerational_transmission"],"chain":"family → community → school → institution → media → platform → diaspora → generation"},
  "relations_to_other_traditions":{"fields":["shared_texts","shared_figures","shared_places","theological_agreement","theological_disagreement","historical_conflict","historical_coexistence","conversion","syncretism","borrowing","translation","interfaith_institutions","ecumenism","polemics"]},
  "esoteric_and_mystical_layer":{"fields":["mystical_schools","initiation","secret_or_restricted_texts","meditation","visionary_practice","alchemy","cosmology","angelology","demonology","numerology","sacred_geometry","symbolism","magic_as_historical_category","esoteric_institutions"],"epistemic_status":"Historical or interpretive unless independently evidenced; cataloguing a supernatural claim does not establish it as empirical fact."},
  "demographic_sources":{"preferred":["national_census","national_population_register","large_representative_survey","Pew","World Religion Database","World Christian Database","academic dataset","religious institution self-report"],"rule":"Triangulate where possible. Pew's global 2010/2020 dataset uses seven broad categories and more than 2,700 sources, while WRD/WCD provide deeper religion and denomination layers; broad categories must not be mistaken for denominational precision."},
  "evidence":{"per_claim":["claim","source","source_type","publication_date","observation_date","retrieved_at","last_verified","confidence","methodology","contradictory_claims","notes"],"claim_types":["self_description","historical","demographic","institutional","legal","economic","observed","estimated","comparative","interpretive","project_symbolic"]},
  "relationships":{"templates":["tradition-derived-from-tradition","tradition-has-text","tradition-interprets-text","tradition-teaches-doctrine","tradition-practices-ritual","tradition-has-school","school-splits-from-school","tradition-has-institution","institution-located-in-place","institution-owns-property","tradition-present-in-country","denomination-present-in-country","tradition-influences-culture","tradition-interacts-with-tradition","tradition-influences-politics","law-regulates-tradition","migration-transmits-tradition","text-translated-into-language","leader-represents-institution","tradition-has-pilgrimage-site"],"time_bound":true},
  "automation":{"refresh_classes":{"demography":"annual/when-new-census-or-survey","leadership":"weekly/monthly where public feeds permit","legal_status":"on legal change","institutions":"monthly/quarterly","membership":"on new published estimate","historical":"curated research","texts":"on corpus/version change"},"pipeline":["discover source","fetch","normalize","validate","compare previous snapshot","store provenance","derive shares/relationships","flag conflicts","publish","mark stale fields"]},
  "integrity_rules":["religion is not ethnicity","affiliation is not belief","membership is not attendance","denomination is not theology alone","historical tradition is not identical to modern institution","symbolic/esoteric material is not automatically empirical","country presence is not universal individual adherence","missing data is not evidence of absence"]
}
