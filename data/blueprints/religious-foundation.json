  "culture_and_transmission":{"fields":["language","literature","music","art","architecture","food","dress","family","education","festivals","calendar","media","film","digital_communities","humor","national_identity","diaspora_culture","intergenerational_transmission","naming","calendar_time","visual_symbols","sacred_sound","material_culture"],"chain":"family -> community -> school -> institution -> media -> platform -> diaspora -> generation"},
