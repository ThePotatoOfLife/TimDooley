  "entity":"religious-foundation",
  "purpose":"Reusable specification for researching a religion, religious family, worldview or historically documented religious formation across ideas, texts, people, ritual, institutions, places, population, material base, law, politics, culture, history and evidence.",
  "identity":{"required":["id","name","self_description","aliases","family","tradition_status","geographic_scope"],"classification":"family -> tradition -> school/denomination -> institution -> community -> practitioner","identity_history":["endonym","exonym","historical_names","translation_variants","classification_changes"]},
