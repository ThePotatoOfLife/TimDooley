  "integrity_rules": [
    "Enrollment is not attendance or completion.",
    "Spending must state current or constant prices where relevant.",
    "Test scores are measurements under particular instruments, not complete measures of learning.",
    "Institutional prestige is not an outcome metric.",
    "Language and religious instruction require documented policy rather than inference.",
    "Historical reforms must retain old system versions."
  ],
  "foundation_contract": "data/blueprints/foundation-blueprint.json",
  "foundation_rule": "When identity, authority, method or operating conditions have a durable founding state, store the generative chronology and reproduction mechanism in a linked Foundation record rather than flattening it into one origin/founded date.",
