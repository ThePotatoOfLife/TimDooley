  "version":"1.1.0","status":"active-blueprint","meta_blueprint":"data/blueprints/blueprint-blueprint.json","purpose":"Blueprint for technologies, platforms, technical standards and digital systems, including lifecycle, dependencies, ownership, adoption and failure modes.","entity":"technology_or_platform","implementation_notes":["Treat the technology as a system, not merely a product name.","Separate inventor, developer, owner, operator, standard setter and manufacturer.","Version changes can create new observations without creating a new canonical entity unless identity/function materially changes.","Record security/privacy assessments with dates; do not convert marketing claims into facts."],"record_schema":{"identity":["technology_id","name","aliases","category","version","status","origin_date","retirement_date"],"function":["purpose","capabilities","inputs","outputs","performance","limitations","standards"],"architecture":["components","software","hardware","protocols","interfaces","data","dependencies","infrastructure"],"organization":["developer","owner","operator","license","governance","maintainers","suppliers"],"adoption":["users","market","geography","sectors","deployment_scale","interoperability","switching_costs"],"risk":["security","privacy","resilience","single_points_of_failure","regulatory_exposure","environmental_impact"],"economy":["revenue_model","cost","investment","procurement","market_share","critical_inputs"],"relationships":["depends_on","compatible_with","replaces","enables","owned_by","operated_by","supplied_by","standardized_by","competes_with"],"evidence":["technical_documentation","standard","filing","academic_source","benchmark","deployment_record","date","confidence"]},"derived_measures":["adoption_rate","dependency_count","supplier_concentration","market_share","criticality_score"],"relationship_templates":["technology-depends-on-infrastructure","platform-owned-by-company","standard-governs-technology","technology-enables-sector"],"validation_rules":["Do not conflate product, platform, protocol, standard and capability.","Ownership/control must be evidence-backed.","Adoption estimates need a denominator and reference date.","Security/privacy claims need an assessment source and date.","Deprecated versions remain historically addressable when needed."],"acquisition_plan":["inventory identifiers and versions","identify technical and ownership sources","capture architecture and dependencies","capture deployment and adoption","capture standards and interoperability","record risks with dated evidence","generate typed relationships","validate against canonical ownership"],"evidence_model":["standard","technical_documentation","academic","filing","administrative","benchmark","reputable_reporting","project_defined"]}
