    "dependency_graph": ["energy_dependency","food_dependency","water_dependency","technology_dependency","financial_dependency","trade_dependency","security_dependency","medical_dependency","critical_mineral_dependency","transport_dependency","digital_dependency","dependency_concentration"],
    "strategic_geography": ["chokepoints","corridors","border_crossings","ports","canals","straits","mountain_passes","river_basins","maritime_routes","submarine_cable_landings","pipeline_corridors","logistics_nodes","buffer_regions"],
    "food_water_system": ["food_production","food_imports","food_exports","fertilizer_dependency","seed_dependency","irrigation","freshwater_withdrawal","water_stress","urban_water","wastewater","food_security","strategic_reserves"],
