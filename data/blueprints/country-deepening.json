    "statistical_quality": ["census_frequency","population_register","economic_statistics_capacity","survey_capacity","administrative_data_quality","revision_policy","data_timeliness","data_disaggregation","metadata_quality","international_comparability","known_breaks_in_series"],
    "measurement_integrity": ["value","unit","reference_period","publication_date","retrieved_at","source","source_type","methodology","revision","confidence","missingness","comparability_warning","historical_break","derived_formula"]
  },
  "relationship_templates": [
    "institution-succeeded-institution",
    "institution-controlled-by-institution",
    "state-obligated-to-entity",
    "country-dependent-on-country",
    "country-supplied-by-country",
    "country-connected-by-infrastructure",
    "asset-owned-by-entity",
    "asset-operated-by-entity",
    "company-subsidiary-of-company",
    "company-supplies-country",
    "company-depends-on-company",
    "religious-institution-present-in-place",
    "tradition-transmitted-through-institution",
    "language-used-by-institution",
    "researcher-network-connects-institutions",
    "diaspora-connects-countries",
    "border-defined-by-treaty",
    "crisis-changed-institution",
    "policy-created-obligation",
    "infrastructure-creates-dependency"
  ],
  "integrity_rules": [
    "A dependency is a measured relationship, not a rhetorical label.",
    "Ownership, operation, regulation and influence are separate edge types.",
    "Historical institutions must not be conflated with their modern successors.",
    "A disputed territory must retain the legal positions of relevant parties and the source basis.",
    "Missing statistics are recorded as missing; they are never converted into zero.",
    "Derived metrics retain their inputs and formulas.",
    "National narratives are documented as sources and institutions, not treated as objective psychological facts.",
    "Symbolic project relationships remain separate from empirical country relationships."
  ]
}
