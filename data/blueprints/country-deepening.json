    "institutional_genealogy": ["institution_id","founding_date","predecessor","successor","mandate","legal_basis","parent_body","subordinate_bodies","reforms","mergers","dissolutions","current_status"],
    "national_calendar_and_time": ["national_day","public_holidays","religious_holidays_recognized","school_calendar","fiscal_year","electoral_cycle","time_zones","daylight_saving","historical_calendar_changes"],
