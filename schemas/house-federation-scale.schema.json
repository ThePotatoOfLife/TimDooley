{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepotatooflife.github.io/TimDooley/schemas/house-federation-scale.schema.json",
  "title": "Potato House Federation Scale",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "authority",
    "purpose",
    "sources",
    "core_rule",
    "nonlinearity",
    "forms",
    "scale_relations",
    "transition_laws",
    "federation_tests",
    "public_boundary"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "authority": {
      "const": "house-federation-scale"
    },
    "purpose": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "core_rule": {
      "type": "string"
    },
    "nonlinearity": {
      "type": "string"
    },
    "forms": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object"
      }
    },
    "scale_relations": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object"
      }
    },
    "transition_laws": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "federation_tests": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "public_boundary": {
      "type": "string"
    }
  }
}
