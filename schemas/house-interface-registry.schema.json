{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepotatooflife.github.io/TimDooley/schemas/house-interface-registry.schema.json",
  "title": "Potato House Interface Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "authority",
    "subroom_registry",
    "principle",
    "interfaces"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "authority": {
      "const": "house-interface-governance"
    },
    "subroom_registry": {
      "const": "data/house/subrooms.json"
    },
    "principle": {
      "type": "string"
    },
    "interfaces": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type",
          "changes",
          "preserves",
          "guard",
          "reversible",
          "public_use"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          },
          "preserves": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "guard": {
            "type": "string"
          },
          "reversible": {
            "type": "string"
          },
          "public_use": {
            "type": "string"
          }
        }
      }
    }
  }
}
