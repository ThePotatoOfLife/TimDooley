{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepotatooflife.github.io/TimDooley/schemas/house-population-pulse.schema.json",
  "title": "Potato House Population Pulse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "authority",
    "purpose",
    "rule",
    "records",
    "summary"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "authority": {
      "const": "house-population-pulse"
    },
    "purpose": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
