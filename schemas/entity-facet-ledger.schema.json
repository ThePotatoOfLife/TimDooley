{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thepotatooflife.github.io/TimDooley/schemas/entity-facet-ledger.schema.json",
  "title": "Entity Facet Ledger",
  "type": "object",
  "required": [
    "id",
    "version",
    "updated",
    "facet_types",
    "strength_levels",
    "entities"
  ],
  "properties": {
    "id": {
      "const": "entity-facet-ledger"
    },
    "version": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facet_types": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "strength_levels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "kind",
          "facets"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "first_seen": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "period": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "facets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "label",
                "strength",
                "scope",
                "provenance"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "strength": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "string"
                },
                "explicit_generalization": {
                  "type": "boolean"
                },
                "title_type": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "story_beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label"
              ],
              "properties": {
                "date": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ref": {
                  "type": "string"
                },
                "strength": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "conclusions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conclusion_history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
